import '../core/app_constants.dart';
import '../core/rtdb_utils.dart';
import '../models/notification_item.dart';
import 'rtdb_paths.dart';

/// Notifikasi di dalam aplikasi, disimpan di **Realtime Database**.
class NotificationService {
  Stream<List<NotificationItem>> watchRecent(String uid) {
    return RtdbPaths.notifications(uid)
        .orderByKey()
        .limitToLast(AppConstants.maxNotifications)
        .onValue
        .map((event) {
      final all = asStringMap(event.snapshot.value);
      final list = [
        for (final entry in all.entries)
          NotificationItem.fromRtdb(entry.key, asStringMap(entry.value)),
      ];
      list.sort((a, b) => b.createdAt.compareTo(a.createdAt));
      return list;
    });
  }

  /// Menandai semua notifikasi yang belum dibaca menjadi sudah dibaca.
  Future<void> markAllAsRead(String uid) async {
    final snapshot = await RtdbPaths.notifications(uid)
        .orderByKey()
        .limitToLast(AppConstants.maxNotifications)
        .get();

    // Kumpulkan semua perubahan, lalu kirim SEKALIGUS dalam satu update.
    final updates = <String, Object?>{};
    asStringMap(snapshot.value).forEach((key, value) {
      if (asStringMap(value)['isRead'] != true) {
        updates['$key/isRead'] = true;
      }
    });
    if (updates.isEmpty) return;

    await RtdbPaths.notifications(uid).update(updates);
  }
}
</file>

<file path="lib/services/rtdb_paths.dart">
import 'package:firebase_database/firebase_database.dart';

/// Alamat (path) di **Firebase Realtime Database** (RTDB).
///
/// RTDB menyimpan data seperti satu pohon JSON besar. Struktur TaugeKu:
///
/// ```
/// users/{uid}/
///   devices/{deviceId}/
///     config/           -> konfigurasi: name, location, wateringSeconds, autoWateringTimes
///     sensor/           -> sensor realtime: temperature, humidity, light, updatedAt, isOnline
///     command/          -> perintah pompa: action, durationSeconds, status, requestedAt
///     lastWatering/     -> waktu siram terakhir: at, durationSeconds, source
///   activities/{pushId}   -> daftar "Aktivitas"
///   notifications/{pushId}-> isi popover lonceng
/// ```
///
/// Semua waktu disimpan sebagai angka milidetik sejak 1 Jan 1970 (epoch ms).
class RtdbPaths {
  RtdbPaths._();

  static final FirebaseDatabase _db = FirebaseDatabase.instance;

  static DatabaseReference user(String uid) => _db.ref('users/$uid');

  static DatabaseReference devices(String uid) => user(uid).child('devices');

  static DatabaseReference device(String uid, String deviceId) =>
      devices(uid).child(deviceId);

  static DatabaseReference command(String uid, String deviceId) =>
      device(uid, deviceId).child('command');

  static DatabaseReference activities(String uid) => user(uid).child('activities');

  static DatabaseReference notifications(String uid) =>
      user(uid).child('notifications');

  /// Node khusus bawaan Firebase: bernilai true bila aplikasi tersambung ke RTDB.
  static DatabaseReference connectionState() => _db.ref('.info/connected');
}
</file>

<file path="lib/services/sensor_service.dart">
import 'package:cloud_firestore/cloud_firestore.dart';

import '../models/sensor_reading.dart';
import 'firestore_paths.dart';

/// Membaca riwayat data sensor dari **Cloud Firestore**.
/// (Data ini DITULIS oleh Wemos, aplikasi hanya membaca.)
class SensorService {
  /// Mengikuti data sensor sejak waktu [since], terbaru lebih dulu.
  /// [limit] membatasi jumlah dokumen agar hemat kuota baca Firestore.
  Stream<List<SensorReading>> watchReadings({
    required String uid,
    required String deviceId,
    required DateTime since,
    required int limit,
  }) {
    return FirestorePaths.readings(uid, deviceId)
        .where('createdAt', isGreaterThanOrEqualTo: Timestamp.fromDate(since))
        .orderBy('createdAt', descending: true)
        .limit(limit)
        .snapshots()
        .map((snapshot) => snapshot.docs.map(SensorReading.fromFirestore).toList());
  }
}
</file>

<file path="lib/services/watering_service.dart">
import 'dart:async';

import 'package:firebase_database/firebase_database.dart';

import 'rtdb_paths.dart';

/// Mengirim perintah penyiraman ke Wemos lewat **Realtime Database**.
///
/// Cara kerjanya (aplikasi TIDAK terhubung langsung ke Wemos):
///   1. Aplikasi menulis node `command` dengan status `pending`.
///   2. Wemos memantau node itu, melihat perintah baru, menyalakan pompa,
///      lalu mengubah status menjadi `done` (atau `failed`) dan mengisi `lastWatering`.
///   3. Aplikasi memantau status itu dan menampilkan hasilnya.
///
/// Node `command` hanya menyimpan perintah TERAKHIR (perintah baru menimpa yang lama).
class WateringService {
  /// Status akhir yang diterima: 'done', 'failed', atau 'timeout'.
  static const String statusDone = 'done';
  static const String statusFailed = 'failed';
  static const String statusTimeout = 'timeout';

  /// Menulis perintah siram. `ServerValue.timestamp` = jam server Firebase.
  Future<void> requestWatering({
    required String uid,
    required String deviceId,
    required int durationSeconds,
  }) {
    return RtdbPaths.command(uid, deviceId).set({
      'action': 'water',
      'durationSeconds': durationSeconds,
      'status': 'pending',
      'requestedAt': ServerValue.timestamp,
    });
  }

  /// Menunggu sampai Wemos mengubah status menjadi `done` atau `failed`.
  /// Jika melewati [timeout], status ditandai `timeout`.
  Future<String> waitForResult({
    required String uid,
    required String deviceId,
    required Duration timeout,
  }) async {
    final statusRef = RtdbPaths.command(uid, deviceId).child('status');

    try {
      return await statusRef.onValue
          .map((event) {
            final value = event.snapshot.value;
            return value is String ? value : 'pending';
          })
          .firstWhere((status) => status == statusDone || status == statusFailed)
          .timeout(timeout);
    } on TimeoutException {
      // Periksa sekali lagi: mungkin Wemos menjawab tepat di detik terakhir.
      final latest = (await statusRef.get()).value;
      if (latest == statusDone) return statusDone;
      if (latest == statusFailed) return statusFailed;

      await statusRef.set(statusTimeout);
      return statusTimeout;
    }
  }
}
</file>

