/// Pilihan filter pada halaman Riwayat.
enum _BatchFilter {
  active('Aktif'),
  finished('Selesai'),
  all('Semua');

  const _BatchFilter(this.label);
  final String label;
}

/// Halaman RIWAYAT: daftar siklus tanam (aktif & selesai).
