      _photoBytes = await picked.readAsBytes();
      notifyListeners();
      return null;
    } catch (e) {
      debugPrint('Gagal memilih foto: $e');
      return 'Gagal memilih foto. Coba lagi.';
    }
  }

  /// Mengisi data contoh ke database (hanya untuk mode debug).
  Future<String?> seedDemoData() async {
